# Every setting the server reads. Copy to .env and fill in. Secrets never go in git.
# The full list with where each value lives is in docs/ENVIRONMENT.md.

PORT=4000
# 127.0.0.1 behind Nginx on the main server, 0.0.0.0 on the second one (the firewall keeps it to the private line)
HOST=127.0.0.1
NODE_ENV=production

# Database. DATABASE_READ_URL is the read-only live copy on the second server, for the lawyers map, top lists and reviews (empty: the main database)
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE
DATABASE_READ_URL=
# Connections each worker may open (defaults 15 and 5). Workers x DB_POOL_MAX must stay under PostgreSQL's max_connections
DB_POOL_MAX=
DB_READ_POOL_MAX=

# Fast memory shared by every server copy: request limits, sign-in guesses, live positions, the job queue.
# Empty: each worker counts on its own. With a password: redis://:PASSWORD@127.0.0.1:6379
REDIS_URL=
# off: this copy puts jobs in the queue but does not run them (the second server, so signed email leaves from the main one only)
JOB_WORKER=

# Sign-in secret, a private random value of at least 32 characters. Production refuses to start without it.
JWT_SECRET=
# How many password checks may run at once in one worker (default 2). Each takes about 64 MB
PASSWORD_SLOTS=

# How many server processes (default 1). Set in the systemd unit on the servers, not here
WEB_WORKERS=
# Which addresses are trusted to pass the visitor's real address (default: loopback). The second server adds the main one
TRUST_PROXY=

# Storage Paths
PUBLIC_STORAGE_PATH=/var/www/mylawyer/storage/public
PRIVATE_STORAGE_PATH=/var/www/mylawyer/storage/private_docs

# Email / SMTP. SMTP_USER and SMTP_PASS only when the mail server asks for a sign-in (the local Postfix does not)
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="My Lawyer <noreply@my-lawyer.online>"

# The control page's second step. ADMIN_CODE_EMAIL: where the code goes (empty: the admin's own email).
# ADMIN_LOGIN_CODE: on / off. Empty means on in production and off elsewhere
ADMIN_CODE_EMAIL=
ADMIN_LOGIN_CODE=

# CORS Allowed Origins, comma separated. * allows any (the apps sign in with a token, not a cookie)
CORS_ORIGIN=*

# Phone notifications: the Firebase service account file (default: firebase-service-account.json next to the code)
FIREBASE_SERVICE_ACCOUNT_PATH=

# TomTom routing and traffic (key named server-routing)
TOMTOM_ROUTING_KEY=
# How many of the nearest lawyers get a road time check when more than 10 are in reach. 0 turns it off
REQUEST_ROAD_CANDIDATES=20
# true lets the emulator's test location through while developing. Leave it out in production
ALLOW_MOCK_LOCATION=
