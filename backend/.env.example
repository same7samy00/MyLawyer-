PORT=4000
HOST=0.0.0.0
NODE_ENV=production

# Database
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE

# Sign-in secret, a private random value of at least 32 characters. Production refuses to start without it.
JWT_SECRET=

# Storage Paths
PUBLIC_STORAGE_PATH=/var/www/mylawyer/storage/public
PRIVATE_STORAGE_PATH=/var/www/mylawyer/storage/private_docs

# Email / SMTP
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_SECURE=false
EMAIL_FROM="MyLawyer <noreply@mylawyer.app>"

# CORS Allowed Origins
CORS_ORIGIN=*


# TomTom routing and traffic (key named server-routing)
TOMTOM_ROUTING_KEY=
# How many of the nearest lawyers get a road time check when more than 10 are in reach. 0 turns it off
REQUEST_ROAD_CANDIDATES=20
