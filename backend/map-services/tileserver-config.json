{
  "options": {
    "paths": {
      "root": "/config",
      "styles": "styles",
      "fonts": "fonts",
      "pmtiles": "pmtiles"
    },
    "serveAllFonts": true,
    "maxScaleFactor": 2,
    "formatOptions": {
      "webp": {
        "quality": 82
      }
    },
    "minRendererPoolSizes": [
      8,
      4,
      2
    ],
    "maxRendererPoolSizes": [
      16,
      8,
      4
    ]
  },
  "styles": {
    "mylawyer": {
      "style": "mylawyer.json"
    }
  },
  "data": {
    "protomaps": {
      "pmtiles": "egypt.pmtiles"
    }
  }
}
